{
  "name": "@sf-agent-po/core",
  "version": "0.0.0",
  "private": true,
  "description": "sf-agent-po v1 core: the SQLite store, domain content, masking, and later the metadata index and the workflow engine",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@sf-agent-po/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "content",
    "vendor"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vendor": "node scripts/vendor-ort.mjs",
    "build": "node scripts/vendor-ort.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "model:manifest": "node scripts/model-manifest.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "onnxruntime-common": "1.31.1"
  },
  "devDependencies": {
    "onnxruntime-web": "1.31.1"
  }
}
