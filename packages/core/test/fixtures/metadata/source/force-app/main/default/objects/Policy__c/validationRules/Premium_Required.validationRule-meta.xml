<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Premium_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &quot;Active&quot;), ISBLANK(Premium__c), $User.Alias != &quot;admin&quot;)</errorConditionFormula>
    <errorDisplayField>Premium__c</errorDisplayField>
    <errorMessage>An active policy needs a premium</errorMessage>
</ValidationRule>
