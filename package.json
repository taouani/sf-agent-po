{
  "name": "sf-agent-po",
  "private": true,
  "description": "Workspace root of sf-agent-po: the published package is built from packages/ by scripts/pack-next.mjs",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run vendor -w @sf-agent-po/core",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taouani/sf-agent-po.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/taouani/sf-agent-po/issues"
  },
  "homepage": "https://github.com/taouani/sf-agent-po#readme",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/core",
    "packages/connectors",
    "packages/mcp",
    "packages/eval"
  ]
}
